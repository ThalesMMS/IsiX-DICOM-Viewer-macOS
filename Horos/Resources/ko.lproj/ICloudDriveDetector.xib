                                    <autoresizingMask key="autoresizingMask" flexibleMinY="YES"/>
                                    <textFieldCell key="cell" sendsActionOnEndEditing="YES" alignment="center" title="데이터베이스 폴더를 플래그하려면 Isis DICOM Viewer를 원하십니까?" id="Ko3-kz-8vd">
